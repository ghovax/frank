{
  "mcpServers": {
    "context7": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://mcp.context7.com/mcp",
      "stateful": true
    },
    "example": {
      "enabled": false,
      "transport": "stdio",
      "command": "uv",
      "arguments": ["run", "python", "examples/mcp/example/server.py"],
      "stateful": true,
      "env": {
        "UV_CACHE_DIR": "/private/tmp/uv-cache"
      },
      "cwd": "."
    }
  }
}
