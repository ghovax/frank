%% How the three layers connect. The connective tissue is a paper's id
%% (DOI / arXiv / PMID / PMCID / OpenAlex): functions in layers 1 and 2 emit
%% records carrying ids, which are fed into layer 2 and layer 3 functions.
%% Render with any Mermaid viewer.
flowchart LR
    subgraph FIND[Layer 1 - find]
        search["search (query)"]
        facets["facets (query, by)"]
        authors["coauthors / author_works (author)"]
    end
    subgraph ANALYZE[Layer 2 - analyze]
        lookup["lookup (id)"]
        citations["citations (id)"]
        similar["similar (id)"]
    end
    subgraph READ[Layer 3 - read]
        fulltext["fulltext (id) - open-access PDF"]
        figures["figures (id) - embedded figures"]
    end

    search -->|result ids| lookup
    search -->|result ids| citations
    search -->|result ids| similar
    search -->|result ids| fulltext
    facets -->|top ids| fulltext
    authors -->|works with ids| citations
    authors -->|works with ids| fulltext
    citations -->|more ids| fulltext
    citations -->|more ids| figures
    similar -->|more ids| fulltext
    fulltext --> figures
