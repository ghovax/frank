{
  "preset": {
    "model": "deepseek-v4-flash",
    "provider": "opencode_go",
    "reasoningEffort": "high"
  },
  "permissionMode": "permissive",
  "tools": {
    "enabledBuiltinTools": [],
    "bash": {
      "enabled": true,
      "backgroundAllowed": true,
      "permissions": {
        "rm *": "ask",
        "sudo *": "deny",
        "chmod *": "ask",
        "chown *": "ask",
        "chattr *": "ask",
        "dd *": "ask",
        "mkfs *": "ask",
        "mount *": "ask",
        "git *": "ask",
        "mv *": "ask",
        "kill *": "ask",
        "gh *": "ask"
      }
    }
  }
}
