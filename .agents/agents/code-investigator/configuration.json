{
  "preset": {
    "model": "gpt-5.6-luna",
    "provider": "chatgpt",
    "reasoningEffort": "high"
  },
  "permissionMode": "read_only",
  "tools": {
    "enabledBuiltinTools": [
      "spawn_agent"
    ],
    "bash": {
      "enabled": true,
      "backgroundAllowed": true,
      "permissions": {
        "rm *": "ask",
        "sudo *": "deny",
        "chmod *": "ask",
        "chown *": "ask",
        "chattr *": "ask",
        "dd *": "ask",
        "mkfs *": "ask",
        "mount *": "ask",
        "git *": "ask",
        "mv *": "ask",
        "kill *": "ask",
        "gh *": "ask"
      }
    },
    "spawnAgent": {
      "enabled": true
    }
  },
  "streamAgentProgress": true
}
