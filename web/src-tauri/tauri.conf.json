{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daisy",
  "version": "0.1.0",
  "identifier": "com.ghovax.daisy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bash ../packaging/build-sidecar.sh && bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daisy",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["server-bin/**/*"]
  }
}
