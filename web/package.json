{
  "name": "frank-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run check:events && next build",
    "start": "next start",
    "lint": "eslint",
    "build:events": "uv run --project .. python ../scripts/generate_event_schema.py && json2ts -i ../shared/generated/events.schema.json -o ../shared/generated/events.ts --unreachableDefinitions",
    "check:events": "uv run --project .. python ../scripts/generate_event_schema.py --check && json2ts -i ../shared/generated/events.schema.json -o \"${TMPDIR:-/tmp}/frank-events.check.ts\" --unreachableDefinitions && diff -u ../shared/generated/events.ts \"${TMPDIR:-/tmp}/frank-events.check.ts\"",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build --bundles app",
    "tauri:dmg": "cargo tauri build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@twemoji/api": "^17.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cronstrue": "^3.24.0",
    "drizzle-orm": "^0.45.2",
    "flowtoken": "^1.0.40",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "motion": "^12.42.1",
    "next": "16.2.9",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "serialize-error": "^13.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.62.0",
    "typescript": "^5"
  }
}
