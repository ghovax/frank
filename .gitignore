# Python
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/

# Virtual environments
.venv
.env
.direnv/

# Editor
.DS_Store
*.pem
*.swo
*.swp

# Node — the web/ app has its own tracked package.json/node_modules; these
# root-anchored entries only catch Node debris if npm is ever run from the repo
# root (which is a Python project). web/ uses its own .gitignore.
/node_modules/
/package.json
/package-lock.json

# Harness state lives in ~/.harness. Repo-local harness state/config is ignored so
# there is exactly one mutable configuration surface.
/.harness/
harness.db
history.db
# A legacy configuration.yaml in the repo root (not the tracked .harness/ one).
/configuration.yaml
