# Per-provider credentials. Each provider's key resolves as: this value, then the
# provider's env var (e.g. ANTHROPIC_API_KEY). OpenAI-compatible providers (opencode,
# custom) also take a base_url; first-party clouds ignore it (LiteLLM knows their
# endpoints).
providers:
  opencode:
    api_key: ""
    base_url: "https://opencode.ai/zen/go/v1"
  anthropic:
    api_key: ""
  openai:
    api_key: ""
  google:
    api_key: ""
  openrouter:
    api_key: ""
  xai:
    api_key: ""
  deepseek:
    api_key: ""
  groq:
    api_key: ""
  mistral:
    api_key: ""
  custom:
    api_key: ""
    base_url: ""

# The default model and provider, stored as separate fields. The model factory
# recombines them into the ``provider/model`` form LiteLLM expects.
default_model: "deepseek-v4-flash"
default_provider: "opencode"

exa:
  api_key: ""

sandbox:
  enabled: true

# Composio: point at the hosted MCP ("connect") URL from the Composio dashboard
# and the harness exposes its tools through the normal MCP path (call_mcp_tool)
# under `server_name`. Which toolkits (e.g. gmail, notion) are available is set on
# the dashboard server; the agent discovers tools dynamically and authorizes
# accounts on first use. The consumer key may also come from the
# COMPOSIO_CONSUMER_API_KEY environment variable (which wins over this value).
composio:
  enabled: false
  url: "https://connect.composio.dev/mcp"
  consumer_api_key: ""
  server_name: "composio"

default_agent: senior-researcher
agents_root_directory: .agents
home_agents_root_directory: ~/.agents
agents_directory: .agents/agents
skills_directory: .agents/skills
