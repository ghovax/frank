  {
   "role": "heading",
   "name": "Accessibility",
   "value": "",
   "context": "",
   "url": "",
   "title": ""
  },
  {
   "role": "strong",
   "name": "",
   "value": "Accessibility",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "text",
   "name": "(often abbreviated to",
   "value": "",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "strong",
   "name": "",
   "value": "A11y",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "text",
   "name": "a",
   "value": "",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "paragraph",
   "name": "",
   "value": "For many people, technology makes things easier. For people with disabilities, technology makes things possible. Accessibility means developing content to be as accessible as possible, no matter an individual's physical and cognitive abilities and how they access the web.",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "strong",
   "name": "",
   "value": "The Web is fundamentally designed to work for all people",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "text",
   "name": ", whatever their hardware, software, language, location, or ability. When the Web meets this goal, it is accessible to people with a diverse range of hearing, movement, sight, and cognitive ability.",
   "value": "",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "text",
   "name": "– (",
   "value": "",
   "context": "Accessibility",
   "url": "",
   "title": ""
  },
  {
   "role": "link",
   "name": "W3C - Accessibility (external)",
   "value": "",
   "context": "Accessibility",
   "url": "https://www.w3.org/standards/webdesign/accessibility",
   "title": ""
  },
  {
   "role": "text",
   "name": ")",
   "value": "",
   "context": "W3C - Accessibility (external)",
   "url": "",
   "title": ""
  },
